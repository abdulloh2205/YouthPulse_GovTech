# ============================================================
#   YouthPulse Backend — Environment Variables Template
#   Ushbu faylni .env nomiga ko'chirib, qiymatlarni kiriting.
# ============================================================

# Server
PORT=3000

# CORS — Frontend URL (vergul bilan ajrating)
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://127.0.0.1:5173

# ---- AI Configuration ----
# AI rejimi: 'mock' | 'gemini' | 'ollama'
# 'mock'   — API kalitsiz sinov uchun aqlli javoblar qaytaradi
# 'gemini' — Google Gemini API orqali ishlaydi
# 'ollama' — Mahalliy Ollama modeli orqali ishlaydi
AI_MODE=mock

# Google Gemini (AI_MODE=gemini bo'lsa to'ldiring)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama (AI_MODE=ollama bo'lsa to'ldiring)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
